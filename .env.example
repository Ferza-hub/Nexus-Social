# Server
PORT=3001
PANEL_URL=http://localhost:3001
PANEL_PASSWORD=nexus2024

# Paths
DB_PATH=data/nexus.db
SESSION_DIR=data/sessions

# Logging
LOG_LEVEL=info

# Max simultaneous Playwright browser instances (tune per available RAM)
MAX_CONCURRENT_BROWSERS=4

# Health monitor cron (every 30 minutes)
HEALTH_CHECK_CRON=*/30 * * * *

